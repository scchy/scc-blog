---
// Giscus 评论组件
// 基于 GitHub Discussions，免费、无广告、支持中文
// 配置项通过 Astro 环境变量注入，避免硬编码
interface Props {
    // 可选覆盖（默认读环境变量）
    repo?: string;
    repoId?: string;
    category?: string;
    categoryId?: string;
}

const { repo, repoId, category, categoryId } = Astro.props;

// Giscus 配置：默认值硬编码（这些值不敏感，非密钥），可用 props 或环境变量覆盖。
// 之所以不依赖 .env：GitHub Actions 构建环境不含本地 .env 文件，硬编码可保证 CI 与本地一致。
const GISCUS_REPO = repo || import.meta.env.PUBLIC_GISCUS_REPO || 'scchy/scc-blog';
const GISCUS_REPO_ID = repoId || import.meta.env.PUBLIC_GISCUS_REPO_ID || 'R_kgDOTqoA4A';
const GISCUS_CATEGORY = category || import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements';
const GISCUS_CATEGORY_ID = categoryId || import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOTqoA4M4DChbE';
---

{
    GISCUS_REPO && GISCUS_REPO_ID && (
        <div class="comments my-16 sm:my-24" id="comments">
            <h2 class="mb-6 font-serif text-xl italic sm:text-2xl">评论</h2>
            <div class="giscus" id="giscus-comments"></div>
        </div>
    )
}

<script>
    // Giscus 通过 giscus.app/client.js 加载，无需 npm 包
    document.addEventListener('astro:page-load', () => {
        initGiscus();
    });
    if (document.readyState !== 'loading') {
        initGiscus();
    }

    function initGiscus() {
        const container = document.getElementById('giscus-comments');
        if (!container || container.hasChildNodes()) return;

        const repo = import.meta.env.PUBLIC_GISCUS_REPO || 'scchy/scc-blog';
        const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || 'R_kgDOTqoA4A';
        if (!repo || !repoId) return;

        const isDark = document.documentElement.classList.contains('dark');
        const giscus = document.createElement('script');
        giscus.src = 'https://giscus.app/client.js';
        giscus.setAttribute('data-repo', repo);
        giscus.setAttribute('data-repo-id', repoId);
        giscus.setAttribute('data-category', import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements');
        giscus.setAttribute('data-category-id', import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOTqoA4M4DChbE');
        giscus.setAttribute('data-mapping', 'pathname');
        giscus.setAttribute('data-strict', '0');
        giscus.setAttribute('data-reactions-enabled', '1');
        giscus.setAttribute('data-emit-metadata', '0');
        giscus.setAttribute('data-input-position', 'bottom');
        giscus.setAttribute('data-theme', isDark ? 'dark' : 'light');
        giscus.setAttribute('data-lang', 'zh-CN');
        giscus.setAttribute('crossorigin', 'anonymous');
        giscus.async = true;
        container.appendChild(giscus);
    }
</script>
